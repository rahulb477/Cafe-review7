+  }
+  if (report.mode === "DRY_RUN") {
+    console.log("\nDry run: nothing was written. Re-run with --apply-counters --confirm-project cafe-review7 after review.");
+  }
+}
+
+main().catch((error) => {
+  console.error(`reconciliation failed: ${error.message}`);
+  process.exitCode = 1;
+});
