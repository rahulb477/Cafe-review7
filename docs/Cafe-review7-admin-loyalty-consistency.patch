++});
++
++test("the ledger only counts real stamps (pending rows and redemptions excluded)", () => {
++  const rows = [
++    { type: "STAMP_ADDED", visitCounted: true, delta: 1 },
++    { type: "STAMP_ADDED", visitCounted: true, delta: 1 },
