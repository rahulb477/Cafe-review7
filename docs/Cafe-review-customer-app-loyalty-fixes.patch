+/**
+ * Review item selection helpers.
+ *
+ * The review wizard builds its options from the CURRENT client's live menu, so
+ * the recorded payload contains real menu items only — never free text, demo
+ * labels or emoji. Shared (no aliases, no Firebase imports) so the Admin/Staff
+ * apps can reuse the same shape.
+ */
+export interface SelectedItemRecord {
+  id: string;
+  name: string;
+}
+
+/**
+ * Zips selected menu item ids with their names (same order, built from the live
+ * menu) into canonical `{ id, name }` records. Entries without a real menu id
+ * or name are dropped; the list is capped at 20 and trimmed to the field limits
+ * enforced by the Security Rules (id ≤ 128, name ≤ 80).
+ */
+export function selectedRecords(answers: {
+  selectedItems: string[];
+  menuItemIds: string[];
+}): SelectedItemRecord[] {
+  const records: SelectedItemRecord[] = [];
+  const max = Math.max(answers.selectedItems.length, answers.menuItemIds.length);
+  for (let i = 0; i < max && records.length < 20; i += 1) {
+    const id = (answers.menuItemIds[i] ?? "").trim();
+    const name = (answers.selectedItems[i] ?? "").trim();
+    if (!id || !name) continue;
+    records.push({ id: id.slice(0, 128), name: name.slice(0, 80) });
+  }
+  return records;
+}
