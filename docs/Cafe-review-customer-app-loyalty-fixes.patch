@@ -0,0 +1,80 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useSession } from "./ClientProvider";
+import { formatFirestoreDate } from "@/shared/customerDisplay";
+import { formatCooldownRemaining } from "@/shared/loyaltyCanonical";
+
+/**
+ * READ-ONLY loyalty summary shared by the Stamps and QR screens.
+ *
+ * Shows the canonical fields of loyaltyAccounts/{uid}:
+ *   current stamps, lifetime stamps, last stamp and the next eligible time.
+ *
+ * The 12-hour cooldown is enforced by Firestore (request.time >= lastStampAt + 12h)
+ * and by the Staff App transaction — this panel only reports it. The customer app
+ * can never add a stamp or count a visit.
+ *
+ * While the cooldown is running it prints, e.g.,
+ *   "Next stamp available in 8h 32m (available at 9:42 PM)"
+ * otherwise it prints the call to action
+ *   "Show my QR to earn a stamp"
+ */
+export function LoyaltyStatusPanel({ compact = false }: { compact?: boolean }) {
+  const stamps = useSession((s) => s.stamps);
+  const lifetimeStamps = useSession((s) => s.lifetimeStamps);
+  const lastStampAt = useSession((s) => s.lastStampAt);
+  const nextStampAt = useSession((s) => s.nextStampAt);
+  const cooldownActive = useSession((s) => s.cooldownActive);
+  const cooldownRemainingLabel = useSession((s) => s.cooldownRemainingLabel);
+
+  // The countdown refreshes the label every 30s without making render impure:
+  // the clock is only read inside the interval callback (state updates are
+  // asynchronous), and the authoritative values always come from the store.
+  const [nowTick, setNowTick] = useState<number | null>(null);
+  useEffect(() => {
+    if (nextStampAt === null) return;
+    const id = window.setInterval(() => setNowTick(Date.now()), 30_000);
+    return () => window.clearInterval(id);
+  }, [nextStampAt]);
+
+  const running = nowTick !== null && nextStampAt !== null ? nextStampAt > nowTick : cooldownActive;
+  const remaining =
+    nowTick !== null && nextStampAt !== null ? formatCooldownRemaining(nextStampAt - nowTick) : cooldownRemainingLabel;
+  const nextLine = running
+    ? `Next stamp available in ${remaining || "a little while"}${
+        nextStampAt ? ` (available at ${formatFirestoreDate(nextStampAt, { withTime: true, fallback: "—" })})` : ""
+      }`
+    : "Show my QR to earn a stamp";
+
+  return (
+    <div className="mt-4 rounded-2xl bg-secondary p-4">
+      <dl className="grid grid-cols-3 gap-3">
+        <Stat label="Current" value={`${stamps}`} />
+        <Stat label="Lifetime" value={`${lifetimeStamps}`} />
+        <Stat label="Last stamp" value={formatFirestoreDate(lastStampAt, { withTime: true, fallback: "—" })} small />
+      </dl>
+      <p
+        className={`mt-3 text-center text-[12.5px] font-semibold ${running ? "text-primary-mid" : "text-primary"}`}
+        aria-live="polite"
+        data-testid="next-stamp-line"
+      >
+        {nextLine}
+      </p>
+      {lifetimeStamps > stamps && (
+        <p className="mt-1 text-center text-[11px] text-muted">
+          Lifetime stamps are never reset — redeeming a reward only clears the card.
+        </p>
+      )}
+    </div>
+  );
+}
+
+function Stat({ label, value, small = false }: { label: string; value: string; small?: boolean }) {
+  return (
+    <div className="text-center">
+      <dt className="text-[10px] font-semibold uppercase tracking-wide text-muted">{label}</dt>
+      <dd className={`font-bold text-primary ${small ? "text-[13px] leading-5" : "text-lg"}`}>{value}</dd>
+    </div>
+  );
+}
