@@ -0,0 +1,8 @@
+/**
+ * Test bootstrap: lets `node --test` load the app's TypeScript modules exactly
+ * as Next does — resolving the `@/*` path alias and extension-less relative
+ * imports (.ts/.tsx). Node strips the types itself, so no build step is needed.
+ */
+import { register } from "node:module";
+
+register("./ts-alias-hooks.mjs", import.meta.url);
diff --git a/tests/ts-alias-hooks.mjs b/tests/ts-alias-hooks.mjs
new file mode 100644
index 0000000..ad39da0
--- /dev/null
+++ b/tests/ts-alias-hooks.mjs
@@ -0,0 +1,27 @@
+/**
+ * Minimal resolver used only by the test runner (see register-ts-aliases.mjs).
+ * - `@/x`      → <repo>/src/x[.ts|.tsx|/index.ts]
+ * - `./x`      → <parent>/x[.ts|.tsx|/index.ts]
+ * Node's built-in type stripping then compiles the TypeScript on the fly.
+ */
+import { existsSync } from "node:fs";
+import { dirname, resolve as resolvePath } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const repoRoot = resolvePath(dirname(fileURLToPath(import.meta.url)), "..");
+const srcRoot = resolvePath(repoRoot, "src");
+
+const candidates = (base) => [base, `${base}.ts`, `${base}.tsx`, `${base}.mjs`, resolvePath(base, "index.ts")];
+const firstExisting = (base) => candidates(base).find((candidate) => existsSync(candidate));
+
+export async function resolve(specifier, context, next) {
+  if (specifier.startsWith("@/")) {
+    const found = firstExisting(resolvePath(srcRoot, specifier.slice(2)));
+    if (found) return next(pathToFileURL(found).href, context);
+  }
+  if (specifier.startsWith(".") && context.parentURL) {
+    const found = firstExisting(resolvePath(dirname(fileURLToPath(context.parentURL)), specifier));
+    if (found) return next(pathToFileURL(found).href, context);
+  }
+  return next(specifier, context);
+}
